<Project>

    <PropertyGroup>
        <Version>7.25.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          The normal upstream build stays on .NET 10.
          LegacyMacOS=true is used only by our Monterey compatibility workflow.
          .NET 8.0.8 is intentionally pinned because it predates macOS 12 EOL and
          still carries a runtime built for Monterey-era deployment targets.

          Current v2rayN source uses C# 13 partial properties. The .NET 10 SDK in
          CI supplies the C# 13 compiler even when the resulting app targets net8.0.
        -->
        <TargetFramework Condition="'$(LegacyMacOS)' != 'true'">net10.0</TargetFramework>
        <TargetFramework Condition="'$(LegacyMacOS)' == 'true'">net8.0</TargetFramework>
        <LangVersion Condition="'$(LegacyMacOS)' == 'true'">13.0</LangVersion>
        <TargetLatestRuntimePatch Condition="'$(LegacyMacOS)' != 'true'">true</TargetLatestRuntimePatch>
        <TargetLatestRuntimePatch Condition="'$(LegacyMacOS)' == 'true'">false</TargetLatestRuntimePatch>
        <RuntimeFrameworkVersion Condition="'$(LegacyMacOS)' == 'true'">8.0.8</RuntimeFrameworkVersion>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <Nullable>annotations</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>2dust</Authors>
        <PackageLicenseExpression>GPL-3.0</PackageLicenseExpression>
        <Copyright>Copyright © 2017-$([System.DateTime]::UtcNow.Year) $(Authors)</Copyright>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <EventSourceSupport>false</EventSourceSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <MetricsSupport>false</MetricsSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>

        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>
</Project>
